# Neon pooled connection string (Project → Connection Details → "Pooled connection"),
# or a local Postgres. Copy this file to .env.local and fill in real values.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with:  npx auth secret
AUTH_SECRET=""

# Google OAuth. Leave blank to hide the "Continue with Google" button.
# Redirect URI: {origin}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Dev-only email login (any email signs you in). NEVER set this in production.
AUTH_DEV_LOGIN="true"

# Comma-separated admin emails (access to /admin: approve events, verify teams).
ADMIN_EMAILS=""

# Turns on posting reviews without an account, and is the pepper the rate
# limiter hashes client addresses with. Generate with:  openssl rand -hex 32
#
# Leave blank and reviews require signing in, which is the safe default: a
# deployment with no secret has no working limit and must not take anonymous
# writes. Bot filtering is Vercel BotID and needs no configuration.
RATE_LIMIT_SECRET=""

# Public site origin, for absolute OG-image URLs (set to the deployed URL in prod).
SITE_URL="http://localhost:3000"
