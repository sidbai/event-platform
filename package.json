{
  "name": "event-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-kjc.ts",
    "db:seed:clubs": "tsx scripts/seed-clubs.ts",
    "db:seed:coaches": "tsx scripts/seed-coaches.ts",
    "db:backfill:covers": "tsx scripts/backfill-news-cover-size.ts",
    "db:backfill:age": "NODE_OPTIONS=--conditions=react-server tsx scripts/backfill-team-age.ts",
    "db:merge:teams": "NODE_OPTIONS=--conditions=react-server tsx scripts/merge-duplicate-teams.ts",
    "db:backfill:naming": "NODE_OPTIONS=--conditions=react-server tsx scripts/backfill-team-naming.ts",
    "db:backfill:clubs": "NODE_OPTIONS=--conditions=react-server tsx scripts/backfill-team-clubs.ts",
    "db:seed:wpl": "tsx scripts/seed-wpl-fixture.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:seed:smoke": "tsx scripts/seed-smoke.ts",
    "smoke": "scripts/smoke.sh",
    "db:seed:listings": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-listings.ts",
    "db:check": "tsx scripts/db-check.ts",
    "sync:event": "NODE_OPTIONS=--conditions=react-server tsx scripts/sync-event.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
